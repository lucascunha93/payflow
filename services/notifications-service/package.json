{
  "name": "notifications-service",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch -p tsconfig.build.json --env-file ../../.env",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/microservices": "^12.5.0",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.5.0",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.4.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "private": true
}
