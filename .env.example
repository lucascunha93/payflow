# Copy to .env and adjust. Values here are for local development only.

# Shared by payments-api (signs tokens) and notifications-service (verifies them).
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=local-development-secret-change-me-0123456789
JWT_EXPIRES_IN_SECONDS=3600

# Single demo user accepted by POST /api/auth/login.
DEMO_USER_EMAIL=demo@payflow.dev
DEMO_USER_PASSWORD=payflow-demo

POSTGRES_PASSWORD=payflow
RABBITMQ_PASSWORD=payflow

# Used when the services run on the host (npm run start:dev) against the
# infrastructure containers. docker compose overrides them with container hostnames.
DATABASE_URL=postgres://payflow:payflow@localhost:5432/payflow
MONGODB_URL=mongodb://localhost:27017/payflow
RABBITMQ_URL=amqp://payflow:payflow@localhost:5672
CORS_ORIGIN=http://localhost:4200

# Optional: change the ports published on your machine by docker compose.
# WEB_PORT=8080
# POSTGRES_PORT=5432
